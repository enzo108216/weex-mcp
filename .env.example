# Copy this file to .env only when you want to manage the service secrets
# yourself. ./scripts/docker-start.sh creates a private .env automatically.
WEEX_APPROVAL_TOKEN_SECRET=
WEEX_SERVICE_AUTH_TOKEN=

# Trade writes stay disabled unless you intentionally change this to true.
WEEX_TRADE_ENABLED=false

# Container listen port and host-published port may be changed independently.
# Keep loopback for local use. Use 0.0.0.0 for all host interfaces, or set a
# specific host interface IP to limit which interface publishes the port.
WEEX_MCP_PORT=8080
WEEX_MCP_HOST_PORT=8080
WEEX_MCP_BIND_HOST=127.0.0.1
# Optional: run the Compose container as a host user/group that can write ./logs.
WEEX_MCP_CONTAINER_UID=65532
WEEX_MCP_CONTAINER_GID=65532

# Optional runtime settings:
WEEX_APPROVAL_TOKEN_TTL_SECONDS=300
WEEX_MAX_REQUEST_BYTES=1048576
WEEX_MARKET_TIMEOUT_SECONDS=5
WEEX_MARKET_MAX_ATTEMPTS=3
WEEX_MARKET_RETRY_BASE_DELAY_SECONDS=0.1
WEEX_ACCOUNT_TIMEOUT_SECONDS=5
WEEX_SPOT_BASE_URL=https://api-spot.weex.com
WEEX_FUTURES_BASE_URL=https://api-contract.weex.com
WEEX_ALLOWED_ORIGINS=
WEEX_SERVER_NAME=weex-mcp

# Optional JSONL audit file. The default Compose file maps this container path
# to ./logs/weex_mcp_audit.log on the host.
WEEX_AUDIT_LOG_FILE=/var/log/weex-mcp/weex_mcp_audit.log
